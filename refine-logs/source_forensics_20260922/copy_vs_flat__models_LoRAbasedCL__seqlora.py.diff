+    def _default_cosine_eta_min(self, lr: float) -> float:
+        """Return the default cosine-scheduler eta_min.  Subclasses can override."""
+        ratio = self.args.get("cosine_min_lr_ratio", self.args.get("min_lr_ratio", None))
+        if ratio is not None:
+            ratio = min(max(float(ratio), 0.0), 1.0)
+            return float(lr) * ratio
+
+        absolute = self.args.get("cosine_eta_min", self.args.get("min_lr", None))
+        if absolute is not None:
+            return float(absolute)
+
+        return 0.1 * float(lr)
+
+    def _compute_task_local_accuracy(self, model, loader, task_start: int, task_end: int) -> float:
+        """Accuracy on [task_start, task_end) classes using only the task-local classifier head."""
+        model.eval()
+        correct, total = 0, 0
+        task_start, task_end = int(task_start), int(task_end)
+        for _, inputs, targets in loader:
+            mask = (targets >= task_start) & (targets < task_end)
+            if not mask.any():
+                continue
+            inputs = inputs[mask].to(self._device)
+            targets_local = targets[mask].to(self._device) - task_start
+            with torch.no_grad():
+                logits = model(inputs)["logits"][:, task_start:task_end]
+            preds = logits.argmax(dim=1)
+            correct += int(preds.eq(targets_local).sum().item())
+            total += int(mask.sum().item())
+        return 0.0 if total == 0 else round(100.0 * correct / total, 2)
+
