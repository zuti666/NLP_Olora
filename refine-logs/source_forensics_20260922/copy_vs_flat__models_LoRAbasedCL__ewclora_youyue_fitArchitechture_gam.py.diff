+                loader,
+                self._device,
+                eval_args,
+                cur_task=int(self._cur_task),
+                task_start=int(task_start),
+                task_end=int(task_end),
+                omega_W=list(self._fisher_past_delta.values()),
+                prefix=prefix,
+                partial_results_path=self._fqa_partial_results_path(prefix),
+            ))
+        return metrics
