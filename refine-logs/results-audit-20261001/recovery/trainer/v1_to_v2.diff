+def require_finite_gradients(params, label):
+    checks = [torch.isfinite(p.grad).all() for p in params if p.grad is not None]
+    if not checks or not bool(torch.stack(checks).all()):
+        raise FloatingPointError(label + ": missing or nonfinite gradients")
+
