+def sam_probe_specification(optimizer):
+    """Independent same-dtype transcription of frozen SAM's nonadaptive first_step.
+
+    Use SAM's norm-of-per-tensor-norms reduction, not GAM's sum-of-squares
+    reduction. Both are mathematically L2 but need not round identically.
+    """
+    params = [p for group in optimizer.param_groups for p in group["params"]]
+    active = [p for p in params if p.grad is not None]
+    require_finite_gradients(params, "SAM clean gradient")
+    shared_device = params[0].device
+    sam_norm = torch.stack([(1.0 * p.grad).norm(p=2).to(shared_device) for p in active]).norm(p=2)
+    gam_squared = None
+    for p in active:
+        term = (p.grad ** 2).sum()
+        gam_squared = term if gam_squared is None else gam_squared + term
+    gam_norm = gam_squared.sqrt()
+    original, predicted = [], []
+    with torch.no_grad():
+        for group in optimizer.param_groups:
+            if group.get("adaptive", False):
+                raise AssertionError("Stage 1 self-SAM specification requires adaptive=False")
+            scale = group["rho"] / (sam_norm + 1e-12)
+            for p in group["params"]:
+                old = p.detach().clone()
+                expected = old.clone()
+                if p.grad is not None:
+                    expected.add_(1.0 * p.grad * scale.to(p))
+                original.append(old)
+                predicted.append(expected)
+    return original, predicted, {"sam_clean_gradient_norm": float(sam_norm),
+        "gam_reduction_norm_of_same_gradient": float(gam_norm),
+        "norm_reduction_relative_difference": abs(float(sam_norm - gam_norm)) / max(abs(float(sam_norm)), 1e-20)}
+
+
+def independent_probe_gradient(model, params, inputs, targets):
+    """Differentiate explicit 20-class CE at the actual SAM probe; restore all state.
+
+    The snapshot also restores the pre-forward RNG and buffers, so the subsequent
+    training backward sees exactly the same model state and stochastic stream.
+    """
+    snapshot = audit.Snapshot(model)
+    try:
+        values = audit.logits(model, inputs)
+        if values.shape[-1] != 20:
+            raise AssertionError("SAM self-audit expects Task0's 20-class classifier")
+        loss = F.cross_entropy(values[:, 0:20], targets, reduction="mean")
+        gradients = torch.autograd.grad(loss, params, allow_unused=True)
+        reference = [torch.zeros_like(p) if g is None else g.detach().clone()
+                     for p, g in zip(params, gradients)]
+        if not all(bool(torch.isfinite(g).all()) for g in reference):
+            raise FloatingPointError("Nonfinite independent SAM probe gradient")
+        return reference
+    finally:
+        snapshot.restore()
+        snapshot.check()
+
+
+def compare_gradient_tensors(actual, reference):
+    if len(actual) != len(reference):
+        raise AssertionError("SAM gradient tensor count mismatch")
+    finite = all(bool(torch.isfinite(g).all()) for g in actual + reference)
+    passed = finite and all(torch.allclose(g, r, rtol=1e-5, atol=1e-7) for g, r in zip(actual, reference))
+    return {"passed": passed, "finite": finite, "tensor_count": len(actual),
+            "max_abs_error": max(float((g - r).abs().max()) for g, r in zip(actual, reference)),
+            "per_tensor_allclose_rtol": 1e-5, "per_tensor_allclose_atol": 1e-7}
 
 
